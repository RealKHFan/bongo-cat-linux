# Bongo Cat bridge settings.
# Edit, save, then close and relaunch Bongo Cat. No need to touch Steam again.

# 1 = the cat reacts while you type in other apps, 0 = off
KEY_BRIDGE=1

# What your mouse clicks in other apps do:
#   paw  = each click taps a paw, so it counts on the counter (default)
#   real = replayed as a real mouse click. NOT recommended: Bongo Cat then also
#          presses whatever button sits where your mouse was last over the cat,
#          e.g. it keeps opening the left chest
#   off  = clicks are ignored
MOUSE_CLICKS=paw

# How the cat becomes clickable on Wayland (needs Bongo Cat's Transparency Fix, F3):
#   always = the cat can always be clicked, the see-through area passes clicks on (default)
#   hover  = like on Windows: only while the mouse is over it. Respects Gaming Mode,
#            but doesn't work during Bongo Cat's first-time setup
#   off    = don't help
CLICK_MODE=always

# Bongo Cat's Transparency Fix (the F3 setting). Pressing Stop in Steam counts
# as a crash, and the game then switches the fix off on its next start.
#   on   = switch it back on before every start (default, recommended)
#   keep = only stop the game from resetting it; your own F3 choice stays
#   off  = leave the game's settings completely alone
TRANSPARENCY_FIX=on

# Only for GE-Proton experiments; leave off with Proton Experimental.
TRANSPARENCY_MODE=off

# Local port the two halves of the key bridge talk on. Only change it if a log
# says the port is in use.
BRIDGE_PORT=47811

# Settings format version; install.sh uses it to update old settings once.
CONFIG_VERSION=3
